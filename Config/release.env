# ============================================================================
# Fonte unica di verità per identità app, versione e firma di rilascio.
# Letto da: scripts/generate-xcode-project.py e scripts/release-mac.sh
#
# Per RINOMINARE l'app (togliere il marchio "RayNeo"): cambia solo
# DISPLAY_NAME_MAC/IPHONE e i BUNDLE_ID_* qui sotto, poi rigenera il progetto:
#     python3 scripts/generate-xcode-project.py
# I nomi interni dei target (RayNeoWorkspace/RayNeoRemote) restano invariati:
# non sono visibili all'utente e cambiarli romperebbe schemi e riferimenti.
# ============================================================================

# --- Nome visibile all'utente (CFBundleDisplayName) -------------------------
DISPLAY_NAME_MAC="Spatial Workspace"
DISPLAY_NAME_IPHONE="Spatial Remote"

# --- Identificatori bundle (reverse-DNS) ------------------------------------
# Per il rilascio usa un prefisso di un dominio tuo, es. com.tuonome.app.
# Nota marchio: evita "rayneo" nel nome pubblico; nel bundle id è meno critico
# ma conviene comunque un identificatore neutro prima della pubblicazione.
BUNDLE_ID_MAC="com.cristianpalmeri.arworkspace"
BUNDLE_ID_IPHONE="com.cristianpalmeri.arworkspace.remote"

# --- Versione ----------------------------------------------------------------
# MARKETING_VERSION = versione mostrata (es. 1.0.0).
# BUILD_NUMBER = intero crescente a ogni build caricata/distribuita.
MARKETING_VERSION="0.11.0"
BUILD_NUMBER="5"

# --- Metadati ----------------------------------------------------------------
COPYRIGHT="© 2026 Cristian Palmeri. Tutti i diritti riservati."
# Categoria App Store / Launchpad. Vedi LSApplicationCategoryType.
CATEGORY_MAC="public.app-category.productivity"
CATEGORY_IPHONE="public.app-category.productivity"

# --- Firma di rilascio (Developer ID, distribuzione diretta notarizzata) -----
# TEAM_ID: configura il tuo Apple Developer Team prima di una release.
TEAM_ID=""
# Nome ESATTO del certificato "Developer ID Application" una volta creato/installato.
# Crealo da Xcode > Settings > Accounts > Manage Certificates > + > Developer ID Application,
# poi incolla qui la riga completa che compare in:  security find-identity -v -p codesigning
# Esempio: "Developer ID Application: Cristian Palmeri (LE75672ZR7)"
DEVELOPER_ID_APPLICATION=""
# Profilo keychain per notarytool (creato una volta con:
#   xcrun notarytool store-credentials "arworkspace-notary" \
#       --apple-id TUA_APPLE_ID --team-id LE75672ZR7 --password APP_SPECIFIC_PASSWORD )
NOTARY_PROFILE="arworkspace-notary"
